# Połączenie z PostgreSQL (na VPS: kontener Docker chess-db, tylko localhost).
# Nazwy zmiennych zostały po wcześniejszej wersji na Supabase.
SUPABASE_DB_NAME=chess
SUPABASE_DB_USER=chess
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=5433

# Maksymalna liczba partii na gracza trzymana w bazie
MAX_GAMES_PER_PLAYER=500

# O ile miesięcy cofamy się przy kolejnym syncu
FETCH_LOOKBACK_MONTHS=1

# true = nie zapisujemy raw_json, tylko same potrzebne pola
DISABLE_RAW_JSON_STORAGE=true
